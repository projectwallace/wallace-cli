		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=20.12.0"
	},
